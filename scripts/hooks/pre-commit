#!/bin/sh
#
# Rustのソースを含むコミットでは、変更したcrateだけでなく作業ツリー全体の
# テストを通す。
#
# 実際に起きた失敗: ori3-rigid のソルバーを変え、ori3-rigid のテストだけを
# 走らせて合格と判断してコミットした。壊れたのは ori3-layers の
# preliminary_base_folds_the_square_into_four_layers で、コミット済みの内容
# だけを取り出した複製で検査するまで気づかなかった。
# crate単位の合格は、他のcrateの合格を意味しない。

staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
staged_for_report=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD)

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$hook_dir/../.." && pwd)
scope_warning_script="$repo_root/scripts/hooks/checks/test-claim-scope-warning.ps1"
scope_health_script="$repo_root/scripts/hooks/checks/hook-health.ps1"
scope_powershell=
if command -v powershell.exe >/dev/null 2>&1; then
    scope_powershell=powershell.exe
elif command -v pwsh >/dev/null 2>&1; then
    scope_powershell=pwsh
elif command -v powershell >/dev/null 2>&1; then
    scope_powershell=powershell
fi

record_scope_health_fallback() {
    fallback_exit_code=$1
    fallback_reason=$2
    if ! command -v sha256sum >/dev/null 2>&1; then
        printf '%s\n' "[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=unknown reason=$fallback_reason health-state=not-recorded (sha256sum unavailable)" >&2
        return
    fi
    fallback_temp=${TEMP:-${TMPDIR:-/tmp}}
    if command -v cygpath >/dev/null 2>&1; then
        fallback_temp=$(cygpath -u "$fallback_temp")
    fi
    fallback_health_dir="${fallback_temp%/}/ori3-hook-health"
    fallback_identity=$(git -C "$repo_root" rev-parse --show-toplevel 2>/dev/null | tr '\\' '/' | tr '[:upper:]' '[:lower:]')
    if [ -z "$fallback_identity" ]; then
        printf '%s\n' "[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=unknown reason=$fallback_reason health-state=not-recorded (repository identity unavailable)" >&2
        return
    fi
    fallback_key=$(printf '%s' "$fallback_identity" | sha256sum | awk '{print $1}')
    fallback_state="$fallback_health_dir/${fallback_key}-test-claim-scope-warning.json"
    if ! mkdir -p "$fallback_health_dir"; then
        printf '%s\n' "[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=unknown reason=$fallback_reason health-state=not-recorded (directory unavailable)" >&2
        return
    fi
    fallback_previous=$(sed -n 's/.*"consecutiveFailures"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$fallback_state" 2>/dev/null | head -n 1)
    case $fallback_previous in
        ''|*[!0-9]*) fallback_previous=0 ;;
    esac
    fallback_failures=$((fallback_previous + 1))
    fallback_last_success=$(sed -n 's/.*"lastSuccessAtUtc"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$fallback_state" 2>/dev/null | head -n 1)
    fallback_last_success_json=null
    if [ -n "$fallback_last_success" ]; then
        fallback_last_success_json=$(printf '"%s"' "$fallback_last_success")
    fi
    fallback_now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    fallback_temporary="$fallback_state.$$.tmp"
    if ! printf '%s\n' "{\"schemaVersion\":1,\"checkId\":\"test-claim-scope-warning\",\"consecutiveFailures\":$fallback_failures,\"lastAttemptAtUtc\":\"$fallback_now\",\"lastSuccessAtUtc\":$fallback_last_success_json,\"lastFailureAtUtc\":\"$fallback_now\",\"lastFailureExitCode\":$fallback_exit_code,\"lastFailureKind\":\"$fallback_reason\"}" > "$fallback_temporary" || ! mv -f "$fallback_temporary" "$fallback_state"; then
        rm -f "$fallback_temporary"
        printf '%s\n' "[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=unknown reason=$fallback_reason health-state=not-recorded (atomic write failed)" >&2
        return
    fi
    printf '%s\n' "[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=$fallback_failures threshold=2 lastSuccess=${fallback_last_success:-never} lastFailure=$fallback_now reason=$fallback_reason" >&2
}

record_scope_health_failure() {
    health_exit_code=$1
    health_reason=$2
    if [ -n "$scope_powershell" ] && [ -f "$scope_health_script" ]; then
        "$scope_powershell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$scope_health_script" -Action RecordFailure -RepositoryRoot "$repo_root" -FailureExitCode "$health_exit_code" -FailureKind "$health_reason"
        health_record_status=$?
        if [ "$health_record_status" -eq 0 ]; then
            return
        fi
        printf '%s\n' "[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=unknown reason=$health_reason health-state=not-recorded (helper exit $health_record_status)" >&2
    fi
    record_scope_health_fallback "$health_exit_code" "$health_reason"
}

record_scope_health_success() {
    if [ -n "$scope_powershell" ] && [ -f "$scope_health_script" ]; then
        "$scope_powershell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$scope_health_script" -Action RecordSuccess -RepositoryRoot "$repo_root"
        health_record_status=$?
        if [ "$health_record_status" -ne 0 ]; then
            printf '%s\n' "[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=unknown reason=success-state-not-recorded health-state=not-recorded (helper exit $health_record_status)" >&2
        fi
    else
        printf '%s\n' '[WARN] HOOK_HEALTH_DEGRADED check=test-claim-scope-warning failures=unknown reason=success-state-not-recorded health-state=not-recorded (helper unavailable)' >&2
    fi
}

if [ -n "$scope_powershell" ] && [ -f "$scope_warning_script" ]; then
    "$scope_powershell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$scope_warning_script" -RepositoryRoot "$repo_root" -FailOnVacuousRustTest
    scope_warning_status=$?
    if [ "$scope_warning_status" -eq 2 ]; then
        printf '%s\n' '[NG] A newly added Rust #[test] has no direct failure signal. Add a failure assertion to the named test before committing.' >&2
        exit 2
    elif [ "$scope_warning_status" -ne 0 ]; then
        record_scope_health_failure "$scope_warning_status" scanner-exit
        printf '%s\n' "[WARN] test-claim scope warning scan could not run (exit $scope_warning_status); commit remains nonblocking" >&2
    else
        record_scope_health_success
    fi
elif [ -f "$scope_warning_script" ]; then
    record_scope_health_failure 127 powershell-unavailable
    printf '%s\n' '[WARN] PowerShell is unavailable; test-claim scope warning scan was skipped' >&2
else
    record_scope_health_failure 127 scanner-script-missing
    printf '%s\n' '[WARN] test-claim scope warning scan script is unavailable; commit remains nonblocking' >&2
fi

# 実装を進めたのに利用者への報告を書かない状態を、重いRust検査の前に止める。
if printf '%s\n' "$staged_for_report" | grep -qE '^(apps|crates)/'; then
    if ! printf '%s\n' "$staged" | grep -Fxq 'docs/報告記録.md'; then
        printf '%s\n' '[NG] apps/ または crates/ を変更するコミットには、docs/報告記録.md の追記が必要です。' >&2
        printf '%s\n' '     利用者への報告を、日時とともに docs/報告記録.md へ書いてからコミットしてください。' >&2
        exit 1
    fi
fi

# Inspect the index, not the worktree: an unstaged correction must not make an
# invalid staged report pass. Run before the Rust-only early exit so docs-only
# report commits are checked too.
report_log_script="$repo_root/scripts/check-report-log.ps1"
if printf '%s\n' "$staged_for_report" | grep -Fxq 'docs/報告記録.md'; then
    if [ -z "$scope_powershell" ]; then
        printf '%s\n' '[NG] PowerShell is unavailable; staged report contract could not be checked.' >&2
        exit 127
    fi
    if [ ! -f "$report_log_script" ]; then
        printf '%s\n' '[NG] scripts/check-report-log.ps1 is unavailable; staged report contract could not be checked.' >&2
        exit 127
    fi
    if printf '%s\n' "$staged_for_report" | grep -qE '^(apps|crates)/'; then
        "$scope_powershell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$report_log_script" -RepositoryRoot "$repo_root" -StagedNewRecordsOnly -RequireNewRecord
    else
        "$scope_powershell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$report_log_script" -RepositoryRoot "$repo_root" -StagedNewRecordsOnly
    fi
    report_log_status=$?
    if [ "$report_log_status" -ne 0 ]; then
        printf '%s\n' "[NG] staged report contract failed (exit $report_log_status)." >&2
        exit "$report_log_status"
    fi
fi

if ! printf '%s\n' "$staged" | grep -qE '(\.rs$|(^|/)Cargo\.(toml|lock)$)'; then
    exit 0
fi

receipt_script="$repo_root/scripts/check-receipt.ps1"

if ! command -v cargo >/dev/null 2>&1; then
    printf '%s\n' '[NG] cargo が見つからないため commit を中止します' >&2
    exit 127
fi

# PowerShell helperが使える場合は、同一内容・同一条件のW4合格を
# 機械内だけで再利用する。helperはmiss/期限切れ/条件違い/判定エラーの
# すべてで、下と同じcargo argvを実行する。CIではreceiptを使わない。
powershell_command=
if command -v powershell.exe >/dev/null 2>&1; then
    powershell_command=powershell.exe
elif command -v pwsh >/dev/null 2>&1; then
    powershell_command=pwsh
elif command -v powershell >/dev/null 2>&1; then
    powershell_command=powershell
fi

if [ -n "$powershell_command" ] && [ -f "$receipt_script" ]; then
    gate_status_path="$repo_root/.origami3/check-receipts/pre-commit-$$.status"
    rm -f -- "$gate_status_path"
    "$powershell_command" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$receipt_script" -RunRustW4 -RepoRoot "$repo_root" -GateStatusPath "$gate_status_path"
    status=$?
    gate_state=
    if [ -f "$gate_status_path" ]; then
        gate_state=$(cat "$gate_status_path")
        rm -f -- "$gate_status_path"
    fi
    if [ "$status" -eq 0 ]; then
        exit 0
    fi
    if [ "$gate_state" = "cargo-started" ]; then
        printf '%s\n' "[NG] Rust W4 gateが失敗したため commit を中止します (終了コード: $status)" >&2
        exit "$status"
    fi
    printf '%s\n' "[WARN] receipt helperがcargo開始前に停止したため、従来どおりRust W4を実行します (終了コード: $status)" >&2
fi

if [ -z "$powershell_command" ] || [ ! -f "$receipt_script" ]; then
    printf '%s\n' '[WARN] receipt helperを使えないため、従来どおりRust W4を実行します' >&2
fi

# 提案の探索の重い3件だけは、ここから外す。花弁折り・つぶし折りの候補を既定で
# 作るようにしたため(crates/ori3-propose/src/enumerate.rs の WITH_EXTRA_CANDIDATES)、
# 最適化なしでは 約7.5時間 / 374秒 / 375秒 かかり、Rustを1行直すたびに
# コミットが止まってしまう。最適化ありなら 1,332秒 / 12秒 / 11秒 で済むので、
# CIの performance ジョブと CLAUDE.md §10.6 の #18〜#20 が最適化ありで走らせる。
# どの検査も消していない。
#
# the_heaviest_proposal_never_hits_the_time_limit も同じ理由でここから外す。
# この検査は「watchdogの打ち切りに当たらないこと」を主張し、watchdogは壁時計なので
# 最適化なしでは16.8〜20.5倍遅くなり必ず当たる(実測: 最適化なしで4候補すべて
# WatchdogExpired。最適化ありでは0件/10回・最大13.851秒)。CIの performance ジョブと
# CLAUDE.md §10.6 の #21 が最適化ありで走らせる。検査は消していない。
printf '%s\n' '[..] Rustの変更を含むため、作業ツリー全体のテストを実行します (cargo test --workspace。提案の探索の重い3件と the_heaviest_proposal_never_hits_the_time_limit は最適化ありで別に走らせるため --skip)'

before_tracked=$(git -C "$repo_root" status --porcelain --untracked-files=no)
status=$?
if [ "$status" -ne 0 ]; then
    printf '%s\n' '[NG] 実行前の追跡対象変更guardを確認できないため commit を中止します' >&2
    exit "$status"
fi

(cd "$repo_root" && cargo test --workspace --no-fail-fast -- --skip completion_search_uses_safe_subsets_and_is_deterministic_ten_out_of_ten --skip named_sample_completes_end_to_end_and_is_deterministic_ten_out_of_ten --skip a_safe_coincident_partial_network_appears_after_the_first_fold --skip the_heaviest_proposal_never_hits_the_time_limit)
status=$?

if [ "$status" -ne 0 ]; then
    printf '%s\n' "[NG] cargo test --workspace が失敗したため commit を中止します (終了コード: $status)" >&2
    exit "$status"
fi

after_tracked=$(git -C "$repo_root" status --porcelain --untracked-files=no)
status=$?
if [ "$status" -ne 0 ]; then
    printf '%s\n' '[NG] 実行後の追跡対象変更guardを確認できないため commit を中止します' >&2
    exit "$status"
fi
if [ "$after_tracked" != "$before_tracked" ]; then
    printf '%s\n' '[NG] Rust W4が追跡対象のファイルを書き換えたため commit を中止します' >&2
    printf '%s\n' '実行前:' >&2
    printf '%s\n' "$before_tracked" >&2
    printf '%s\n' '実行後:' >&2
    printf '%s\n' "$after_tracked" >&2
    exit 1
fi

printf '%s\n' '[OK] 作業ツリー全体のRustテストに合格しました'
exit 0
