#!/bin/sh

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$hook_dir/../.." && pwd)
check_script="$repo_root/scripts/check.ps1"
check_ci_script="$repo_root/scripts/check-ci.ps1"

if [ ! -f "$check_script" ]; then
    printf '%s\n' "[NG] 検査スクリプトが見つからないため push を中止します: $check_script" >&2
    exit 1
fi

if [ ! -f "$check_ci_script" ]; then
    printf '%s\n' "[NG] CI再現検査スクリプトが見つからないため push を中止します: $check_ci_script" >&2
    exit 1
fi

if command -v powershell.exe >/dev/null 2>&1; then
    powershell_command=powershell.exe
elif command -v pwsh >/dev/null 2>&1; then
    powershell_command=pwsh
elif command -v powershell >/dev/null 2>&1; then
    powershell_command=powershell
else
    printf '%s\n' '[NG] PowerShell が見つからないため push を中止します' >&2
    exit 127
fi

"$powershell_command" -NoProfile -ExecutionPolicy Bypass -File "$check_script" -RepositoryRoot "$repo_root"
check_status=$?

if [ "$check_status" -ne 0 ]; then
    printf '%s\n' "[NG] 事前検査が失敗したため push を中止します (終了コード: $check_status)" >&2
    exit "$check_status"
fi

"$powershell_command" -NoProfile -ExecutionPolicy Bypass -File "$check_ci_script" -RepositoryRoot "$repo_root"
check_ci_status=$?

if [ "$check_ci_status" -ne 0 ]; then
    printf '%s\n' "[NG] CI再現検査が失敗したため push を中止します (終了コード: $check_ci_status)" >&2
    exit "$check_ci_status"
fi

printf '%s\n' '[OK] 作業ツリー検査とCI再現検査に合格しました'
exit 0
